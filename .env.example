# LLM Token Manager example environment
# Copy this file to `.env` and adjust values as needed.
#
# The infrastructure defaults below match `docker-compose.yml` in this repo:
# - PostgreSQL: localhost:5433 (myuser / mypassword / mydb)
# - Redis: localhost:6379
# - RabbitMQ: localhost:5672 (rmq_user / rmq_password)

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=LLM Token Manager
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------------------------
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL
# Matches local Docker compose defaults
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword
DATABASE_NAME=mydb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# Redis
# Matches local Docker compose defaults
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# RabbitMQ / Celery broker
# Matches local Docker compose defaults
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rmq_user
RABBITMQ_PASSWORD=rmq_password
RABBITMQ_VHOST=/

# Optional override. Leave empty to let the app build the broker URL
# from the RabbitMQ settings above.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=10
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
REQUIRE_CELERY_WORKER_ON_STARTUP=false

# ------------------------------------------------------------------------------
# Rate limiting / caching
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TOKEN_GENERATE_PER_MINUTE=30
RATE_LIMIT_TOKEN_REFRESH_PER_MINUTE=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# LLM provider credentials
# Set only the providers you plan to use.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Default LLM behavior
# ------------------------------------------------------------------------------
DEFAULT_MAX_TOKENS=1000
DEFAULT_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# JWT auth
# Replace with a strong secret for real environments.
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_ENABLED=false
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
