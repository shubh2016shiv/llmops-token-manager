    def test_pause_deployment_success(
        self,
        app,
        client,
        mock_operator_user,
        sample_user_response,
    ):
        """Valid request reaches the persistence layer via Depends() and returns
        a PauseDeploymentAllocationResponse with allocation_status = 'PAUSED'."""
        from app.auth.auth_dependencies import get_current_user

        app.dependency_overrides[get_current_user] = lambda: mock_operator_user

        mock_users_service = MagicMock()
        mock_users_service.get_user_by_id = AsyncMock(return_value=sample_user_response)
        app.dependency_overrides[get_users_service] = lambda: mock_users_service

        mock_persistence = MagicMock()
        mock_persistence.pause_deployment = AsyncMock(
            return_value={
                "token_request_id": "pause_req_123",
                "user_id": mock_operator_user.user_id,
                "llm_provider": "openai",
                "llm_model_name": "gpt-4",
                "deployment_name": None,
                "cloud_provider": None,
                "api_endpoint_url": "https://api.openai.com/v1",
                "deployment_region": "eastus2",
                "token_count": 100000,
                "allocation_status": "PAUSED",
                "allocated_at": datetime.now(timezone.utc),
                "expires_at": datetime.now(timezone.utc),
                "request_context": {"operation": "pause_deployment"},
                "temperature": None,
                "top_p": None,
                "seed": None,
            }
        )
        # Use the Depends() seam — no @patch required
        app.dependency_overrides[get_allocation_persistence] = lambda: mock_persistence

        payload = {
            "llm_provider": "openai",
            "llm_model_name": "gpt-4",
            "api_endpoint_url": " https://api.openai.com/v1 ",
            "pause_reason": "provider outage",
            "pause_duration_minutes": 30,
        }

        response = client.put("/api/v1/tokens/pause-deployment", json=payload)
        assert response.status_code == 200
        assert response.json()["allocation_status"] == "PAUSED"

        mock_users_service.get_user_by_id.assert_called_once_with(
            mock_operator_user.user_id
        )
        mock_persistence.pause_deployment.assert_called_once()
        assert mock_persistence.pause_deployment.call_args[1]["api_endpoint"] == (
            "https://api.openai.com/v1"
        )

        app.dependency_overrides.clear()


