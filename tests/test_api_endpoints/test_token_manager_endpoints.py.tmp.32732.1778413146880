    }


def _make_allocation_response(
    user_id: UUID,
    status: str = "ACQUIRED",
    token_request_id: str = "req_123abc",
) -> TokenAllocationResponse:
    """Build a minimal valid TokenAllocationResponse for use in tests."""
    return TokenAllocationResponse(
        token_request_id=token_request_id,
        user_id=user_id,
        llm_provider="openai",
        llm_model_name="gpt-4",
        token_count=150,
        allocation_status=status,
        allocated_at=datetime.now(timezone.utc),
        expires_at=datetime.now(timezone.utc) + timedelta(hours=1),
        deployment_name="gpt-4-eastus",
        api_endpoint_url="https://api.openai.com/v1",
        deployment_region="eastus2",
        request_context={"project": "test", "team": "research"},
    )


