# ============================================================
# LLM Token Manager — Environment Variables
# ============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# TWO consumers read this file:
#   1. docker-compose.yml  —  reads vars via ${VAR} substitution
#   2. The application      —  reads vars at runtime (FastAPI / Celery)
#
# NOTE ON HOST VALUES:
#   When running INSIDE Docker, docker-compose.yml overrides
#   DATABASE_HOST / REDIS_HOST / RABBITMQ_HOST to use Docker
#   service names (postgres, redis, rabbitmq) automatically.
#   The localhost defaults below are for LOCAL development
#   (FastAPI running directly on your machine).
# ============================================================

# ------------------------------------------------------------------
#  Application
# ------------------------------------------------------------------
APP_NAME=LLM Token Manager
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------
#  FastAPI (local development)
# ------------------------------------------------------------------
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# ------------------------------------------------------------------
#  PostgreSQL
# ------------------------------------------------------------------
#  docker-compose reads:  POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, POSTGRES_HOST_PORT
#  application reads:     DATABASE_HOST, DATABASE_PORT, DATABASE_USER, DATABASE_PASSWORD, DATABASE_NAME
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_HOST_PORT=5433
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword
DATABASE_NAME=mydb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------
#  Redis
# ------------------------------------------------------------------
#  docker-compose reads:  REDIS_HOST_PORT, REDIS_PASSWORD
#  application reads:     REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password
REDIS_HOST_PORT=6379
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------
#  RabbitMQ / Celery broker
# ------------------------------------------------------------------
#  docker-compose reads:  RABBITMQ_DEFAULT_USER, RABBITMQ_DEFAULT_PASS, RABBITMQ_AMQP_PORT, RABBITMQ_MGMT_PORT
#  application reads:     RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD, RABBITMQ_VHOST
RABBITMQ_DEFAULT_USER=rmq_user
RABBITMQ_DEFAULT_PASS=rmq_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rmq_user
RABBITMQ_PASSWORD=rmq_password
RABBITMQ_VHOST=/

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=10
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
REQUIRE_CELERY_WORKER_ON_STARTUP=false

# ------------------------------------------------------------------
#  Rate limiting / caching
# ------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TOKEN_GENERATE_PER_MINUTE=30
RATE_LIMIT_TOKEN_REFRESH_PER_MINUTE=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------
#  LLM provider credentials
#  Set only the providers you plan to use.
# ------------------------------------------------------------------
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------
#  Default LLM behavior
# ------------------------------------------------------------------
DEFAULT_MAX_TOKENS=1000
DEFAULT_TEMPERATURE=0.7

# ------------------------------------------------------------------
#  JWT auth
#  Replace with a strong secret for real environments.
# ------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_ENABLED=false
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------
#  FastAPI (Docker — activate when ready)
# ------------------------------------------------------------------
FASTAPI_HOST_PORT=8000
