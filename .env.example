# ============================================================
# LLM Token Manager — Environment Variables
# ============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# TWO consumers read this file:
#   1. Compose      — reads vars via ${VAR} substitution at PARSE time
#   2. The app      — reads vars at RUNTIME (pydantic-settings)
#
# Those are different moments, and confusing them causes most "why is this
# value ignored?" questions. Full precedence chain: infra/docs/02-configuration.md
#
# ------------------------------------------------------------
# NOTE ON localhost VALUES BELOW
# ------------------------------------------------------------
#   The localhost defaults are for running the app DIRECTLY on your machine.
#   Inside Compose they are deliberately overridden: infra/compose/compose.app.yml
#   sets DATABASE_HOST/REDIS_HOST/RABBITMQ_HOST to Docker service names, and
#   `environment:` beats `env_file:`. That is the mechanism which lets ONE .env
#   serve both host runs and containerised runs. Do not "fix" the localhost
#   values to service names — that breaks host runs and changes nothing in Docker.
# ============================================================

# ============================================================
#  COMPOSE FILE CHAIN  —  read this first
# ============================================================
#  The stack is split into one file per tier so each file is one readable
#  concept instead of a 600-line monolith:
#
#     docker-compose.yml                    chassis: networks, volumes
#     infra/compose/compose.data.yml        pgbouncer
#     infra/compose/compose.messaging.yml   redis, rabbitmq
#     infra/compose/compose.app.yml         api, token_queue_consumer
#     infra/compose/compose.dev.yml         host ports, live reload
#
#  COMPOSE_FILE tells Compose to merge them, so you type the short command:
#
#     docker compose up -d          <- reads the chain below automatically
#
#  instead of a six-flag invocation. Order matters: LAST file wins on conflicts.
#
#  The separator is ':' on Linux/macOS/Git Bash and ';' on native Windows
#  PowerShell/cmd. If Compose reports "no configuration file provided", that
#  separator is almost always why — set COMPOSE_PATH_SEPARATOR explicitly.
#
#  TO SWITCH TO PRODUCTION: replace compose.dev.yml with compose.prod.yml.
#  Never load both — dev publishes host ports that prod cannot take back
#  (Compose APPENDS list keys like `ports`). See infra/docs/01-networking.md.
# ------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:infra/compose/compose.data.yml:infra/compose/compose.messaging.yml:infra/compose/compose.app.yml:infra/compose/compose.dev.yml
COMPOSE_PATH_SEPARATOR=:

# ------------------------------------------------------------
#  Shared platform network (owned by llm_services)
# ------------------------------------------------------------
#  This stack does NOT create this network — it attaches to one llm_services
#  already created. llm_services/docker-compose.yml declares `networks: llm_net:`
#  with no `name:` key, so Compose prefixes it with that project's name,
#  producing the real network name below.
#
#  Confirm the actual name on your machine with:  docker network ls
#  llm_services MUST be running before this stack starts.
PLATFORM_NETWORK_NAME=llm_services_llm_net

# ==============================================================================
#  PORT REGISTRY  <<< THE ONE PLACE PORTS ARE DEFINED. START HERE.
# ==============================================================================
#  Every host port this stack uses is declared in THIS BLOCK and nowhere else.
#  The compose files reference them with ${VAR:?} (NO fallback defaults), so a
#  missing value fails immediately with a named error instead of silently
#  starting on some other port. One value, one place.
#
#  ---------------------------------------------------------------------------
#  HOST ports vs CONTAINER ports -- the distinction that causes most confusion
#  ---------------------------------------------------------------------------
#  HOST port      = a port on YOUR MACHINE. Machine-wide and shared, so two
#                   projects CAN collide here. Only these are your problem.
#  CONTAINER port = the port inside the container. Private to that container.
#                   Two containers can both use 6379 with no conflict at all.
#
#  That is why the mappings below look "mismatched" (8001->8000, 6380->6379):
#  only the left/host side had to move, because llm_services already claimed
#  the obvious defaults. The container side stays conventional.
#
#  ---------------------------------------------------------------------------
#  ALREADY TAKEN ON THIS MACHINE BY llm_services
#  ---------------------------------------------------------------------------
#    5432  llm_services PostgreSQL   <- shared DB, this stack connects to it
#    6379  llm_services Redis        <- their cache. NOT ours. See ADR-003.
#    8200  llm_services Vault
#    8000  llm_services app          <- why our API uses 8001
#
#  Verify anytime with:  docker ps --format "{{.Names}}\t{{.Ports}}"
#  Validate this whole block with:  .\infra\scripts\infra.ps1 doctor
#
#  ---------------------------------------------------------------------------
#    VARIABLE               HOST  ->  CONTAINER   SERVICE
#  ---------------------------------------------------------------------------
#    API_HOST_PORT          8001  ->  8000        FastAPI  (8000 taken)
#    PGBOUNCER_HOST_PORT    6432  ->  6432        PgBouncer
#    REDIS_HOST_PORT        6380  ->  6379        Redis    (6379 taken)
#    RABBITMQ_AMQP_PORT     5672  ->  5672        RabbitMQ broker
#    RABBITMQ_MGMT_PORT    15672  -> 15672        RabbitMQ management UI
#  ---------------------------------------------------------------------------
#  NOTE: no inline `# comments` on the assignment lines below, on purpose.
#  Docker Compose strips them correctly, but simple KEY=VALUE parsers (including
#  the ones in infra/scripts/*) do not, and would read the comment text as part
#  of the port number.
API_HOST_PORT=8001
PGBOUNCER_HOST_PORT=6432
REDIS_HOST_PORT=6380
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
#  ---------------------------------------------------------------------------
#  Published ONLY by infra/compose/compose.dev.yml, and only on 127.0.0.1.
#  compose.prod.yml publishes NOTHING and ignores every value above.
#
#  HOST-RUN MODE: if you run the app directly on your machine (not in Docker),
#  it must connect to the HOST ports above. The DATABASE_/REDIS_/RABBITMQ_
#  values further down are those connection targets and MUST agree with this
#  registry. `doctor` verifies that automatically -- it is the check that catches
#  "app silently talking to llm_services' Redis instead of ours".
# ==============================================================================

# ------------------------------------------------------------------
#  Application
# ------------------------------------------------------------------
APP_NAME=LLM Token Manager
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------
#  FastAPI (local development)
# ------------------------------------------------------------------
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# ------------------------------------------------------------------
#  PostgreSQL — OWNED BY llm_services, NOT by this stack
# ------------------------------------------------------------------
#  There is no postgres service in this project's compose files, and there
#  cannot be one. This stack's own table `llm_token_allocations` has FOREIGN KEY
#  constraints into `tenants`, `users`, and `tenant_deployments`, which
#  llm_services owns and creates. PostgreSQL cannot enforce a foreign key across
#  two servers. See infra/docs/04-decisions.md ADR-001.
#
#  The old POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_HOST_PORT
#  keys have been REMOVED from this file. Nothing read them any more once this
#  stack stopped running its own database, and leaving them meant two sets of
#  credentials for one database, drifting apart. (The previous defaults here —
#  myuser/mypassword/mydb — already contradicted the real database.)
#
#  These values MUST match llm_services/.env:
#      DATABASE_USER      == its POSTGRES_USER      (default: llm_user)
#      DATABASE_NAME      == its POSTGRES_DB        (default: llm_services)
#      DATABASE_PASSWORD  == its POSTGRES_PASSWORD
#
#  Its POSTGRES_PASSWORD is RANDOMLY GENERATED per machine on first run by
#  llm_services/infrastructure/manage_local_infrastructure.py, so copy the real
#  value across rather than typing a placeholder.
#
#  DATABASE_HOST/PORT below are for running the app on your HOST, pointed at
#  whatever host port llm_services publishes. Inside Compose they are overridden
#  to pgbouncer:6432.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=llm_user
DATABASE_PASSWORD=copy-POSTGRES_PASSWORD-from-llm_services/.env
DATABASE_NAME=llm_services
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------
#  PgBouncer — connection pooler (app connects here, not to PostgreSQL directly)
# ------------------------------------------------------------------
#  docker-compose reads:  PGBOUNCER_HOST_PORT
#  application reads:     PGBOUNCER_ENABLED, PGBOUNCER_HOST, PGBOUNCER_PORT
#
#  When PGBOUNCER_ENABLED=true the application routes all DB connections through
#  PgBouncer (transaction mode) instead of PostgreSQL directly.
#  Local dev:  pgbouncer runs in Compose, published on 127.0.0.1:6432 by the dev overlay.
#  In Docker:  compose.app.yml forces DATABASE_HOST/PORT to pgbouncer:6432 regardless.
#
#  Tuning (pool_mode, pool sizes, timeouts) is NOT set here. It lives in exactly
#  one place: infra/config/pgbouncer/pgbouncer.ini. Two mechanisms configuring
#  one service is how a stack becomes unreasonable-about.
PGBOUNCER_ENABLED=true
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

#  Password for PgBouncer's OWN admin console (SHOW POOLS / SHOW STATS), which
#  is not a PostgreSQL role — it exists only inside PgBouncer, so this value is
#  independent of the database password and can be anything.
#
#  Used by infra/scripts/infra.{sh,ps1} to generate
#  infra/config/pgbouncer/userlist.txt, which is git-ignored because it contains
#  the cleartext database password.
PGBOUNCER_ADMIN_PASSWORD=change-me-local-pgbouncer-admin

# ------------------------------------------------------------------
#  Redis — a DEDICATED instance, deliberately not llm_services' Redis
# ------------------------------------------------------------------
#  Compose reads:       REDIS_HOST_PORT, REDIS_PASSWORD
#  Application reads:   REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD
#
#  This is a separate container from llm_services' Redis, and the reason is one
#  setting: theirs runs maxmemory-policy allkeys-lru. Correct for a cache whose
#  contents can be re-read from PostgreSQL; a CORRECTNESS BUG for our Lua token
#  counters, which are the live record of allocated capacity. LRU eviction would
#  silently delete a counter, it would read back as zero, and the system would
#  over-allocate capacity with no error anywhere.
#
#  maxmemory-policy is instance-wide, so a different DB index does not help.
#  Ours runs `noeviction` — see infra/config/redis/redis.conf and ADR-003.
#
#  REDIS_PASSWORD is passed to redis-server via --requirepass because redis.conf
#  cannot read environment variables and committing the password would leak it.
#
#  REDIS_HOST_PORT defaults to 6380, not 6379: llm_services runs its own Redis
#  published on 6379, and both stacks can be running on the same machine at
#  once (this stack ATTACHES to llm_services' network). 6379 would collide.
#  REDIS_PORT (6379) is the CONTAINER-internal port and is unaffected — it is
#  never on the host, so it does not need to differ between the two Redis
#  instances.
#  REDIS_PORT is 6380, NOT 6379, and that distinction is load-bearing: 6379 on
#  this machine is llm_services' Redis. A host-run app pointed at 6379 would
#  silently connect to the WRONG, LRU-evicting instance -- the exact bug ADR-003
#  exists to prevent. 6380 is our dedicated instance (see PORT REGISTRY above).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=redis_password
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------
#  RabbitMQ
# ------------------------------------------------------------------
#  Compose reads:       RABBITMQ_USER, RABBITMQ_PASSWORD, RABBITMQ_VHOST,
#                       RABBITMQ_AMQP_PORT, RABBITMQ_MGMT_PORT
#  Application reads:   RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER,
#                       RABBITMQ_PASSWORD, RABBITMQ_VHOST
#
#  The old RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS keys are GONE. They held
#  the same two values as RABBITMQ_USER / RABBITMQ_PASSWORD — one pair for the
#  broker, one for the app — which could silently drift apart and produce an
#  authentication failure between two things that "obviously" matched.
#  compose.messaging.yml now maps RABBITMQ_USER -> RABBITMQ_DEFAULT_USER itself.
#
#  FIRST-BOOT ONLY: RabbitMQ reads these credentials only when initialising an
#  empty data volume. Changing them later has NO effect — the existing volume
#  keeps the old user. To rotate for real, use rabbitmqctl or delete the volume.
#
#  Queue topology (exchanges, queues, dead-lettering, quorum settings) is NOT
#  configured here. It is declared in app/resilience/token_queue/topology.py so
#  the consumer and the topology cannot disagree.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rmq_user
RABBITMQ_PASSWORD=rmq_password
RABBITMQ_VHOST=/

# ------------------------------------------------------------------
#  Application process sizing (read by Compose)
# ------------------------------------------------------------------
#  API_WORKERS: uvicorn worker processes in production. Ignored by the dev
#  overlay, which must run a single worker because --reload and --workers are
#  mutually exclusive. Rule of thumb: (2 x CPU cores) for I/O-bound work, then
#  measure. Every worker is a full process with its own DB pool — raising this
#  multiplies connections arriving at PgBouncer.
API_WORKERS=2

#  Consumer process layout. Passed as --concurrency / --prefetch-count to
#  app/resilience/token_queue/consumer.py.
#
#  PREFETCH is the subtle one: it is how many unacknowledged messages a consumer
#  may hold. Too high and one slow consumer hoards work while others idle; too
#  low and throughput suffers from round-trip latency.
TOKEN_QUEUE_CONSUMER_CONCURRENCY=8
TOKEN_QUEUE_CONSUMER_PREFETCH_COUNT=20

# ------------------------------------------------------------------
#  Celery — NO LONGER RUNS ANY CONTAINER
# ------------------------------------------------------------------
#  The three Celery services (worker, token maintenance worker, beat) were
#  removed from Compose because all three were already dead code: they ran
#  `-A app.llm_client_provisioning...`, which is now
#  app/llm_client_provisioning_OBSELETE/, and no `celery_app` object exists
#  anywhere in live code. See infra/docs/04-decisions.md ADR-004.
#
#  The keys below are KEPT only because app/core/config/rabbitmq_configs.py and
#  resiliency_configs.py still declare the fields, and removing them is an
#  application change rather than an infrastructure one. No container reads them.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=10
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
REQUIRE_CELERY_WORKER_ON_STARTUP=false

# ------------------------------------------------------------------
#  Rate limiting / caching
# ------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TOKEN_GENERATE_PER_MINUTE=30
RATE_LIMIT_TOKEN_REFRESH_PER_MINUTE=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------
#  LLM provider credentials
#  Set only the providers you plan to use.
# ------------------------------------------------------------------
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------
#  Default LLM behavior
# ------------------------------------------------------------------
DEFAULT_MAX_TOKENS=1000
DEFAULT_TEMPERATURE=0.7

# ------------------------------------------------------------------
#  JWT auth
#  Replace with a strong secret for real environments.
# ------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_ENABLED=false
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------
#  Host ports published by the DEV overlay only
# ------------------------------------------------------------------
#  These are the LEFT side of "HOST:CONTAINER" in infra/compose/compose.dev.yml.
#  Change them freely to dodge conflicts with other local services — the
#  container-side ports never change, so nothing inside the stack is affected.
#
#  All of them bind to 127.0.0.1 explicitly, so they are reachable only from this
#  machine. That matters more than it looks: Docker's port publishing writes
#  NAT rules that BYPASS most host firewalls, so a 0.0.0.0 bind really does expose
#  the service to your whole network.
#
#  compose.prod.yml publishes NOTHING and ignores every variable in this section.
#
#  8001, not 8000: llm_services' own `app` service (llm_services/docker-compose.yml)
#  also defaults to host port 8000. Both stacks can run on this machine at once
#  (this stack attaches to llm_services' network), so 8000 would collide.

#  FASTAPI_HOST / FASTAPI_PORT (further up) are read by the APPLICATION for host
#  runs. FASTAPI_HOST_PORT was the old Compose publish port and is superseded by
#  API_HOST_PORT above — the service is named `api`, so the variable matches it.
FASTAPI_HOST_PORT=8000
