"""
Comprehensive Unit Tests for Token Manager Endpoints
=====================================================
Unit tests for token management endpoints using service-layer mocking.
All service calls are intercepted via FastAPI dependency_overrides —
the correct seam for testing FastAPI Depends()-wired services.

Test Coverage:
- Acquire tokens (15 tests)
- Retry acquire tokens (5 tests)
- Release tokens (8 tests)
- Pause deployment (3 tests)
"""

from datetime import datetime, timedelta, timezone
from unittest.mock import AsyncMock, MagicMock
from uuid import UUID

from fastapi import FastAPI
from fastapi.testclient import TestClient
import pytest

from app.api.token_manager_endpoints import (
    get_allocation_persistence,
    get_token_acquisition_service,
    get_token_release_service,
    get_token_retry_service,
    get_users_service,
    router,
)
from app.core.exceptions import (
    AllocationNotFoundError,
    DatabaseUnavailableError,
    DeploymentConfigurationError,
    TokenLimitExceededError,
    UserInactiveError,
    UserNotFoundError,
)
from app.models.response_models import TokenAllocationResponse


# ============================================================================
# TEST SETUP
# ============================================================================


@pytest.fixture
def app():
    """Create FastAPI app with token manager endpoints router."""
    app = FastAPI()
    app.include_router(router)
    return app


@pytest.fixture
def client(app):
    """Create test client for the FastAPI app."""
    return TestClient(app)


@pytest.fixture
def sample_client_request():
    """Sample token allocation client request data."""
    return {
        "llm_provider": "openai",
        "llm_model_name": "gpt-4",
        "input_data": "Test prompt for token estimation",
        "deployment_region": "eastus2",
