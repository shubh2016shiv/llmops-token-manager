    }


@pytest.fixture
def sample_user_response():
    """Sample user response for mocking."""
    return {
        "user_id": UUID("89e0d113-912f-4272-ba13-6b3b6d9677c4"),
        "username": "testuser",
        "email": "test@example.com",
        "first_name": "Test",
        "last_name": "User",
        "role": "developer",
        "status": "active",
        "created_at": datetime.now(timezone.utc),
